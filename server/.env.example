# Copy to .env and adjust. Every variable is described in README.md ("Environment variables").

# Used by compose / Caddy: every host name the API answers on (comma-separated)
API_HOSTS=api.lessnoise.ch, api.stadtlaerm.ch

# Used by the app (DB_PATH, MAP_DIR and TRUST_PROXY are set in compose.yaml)
MIN_DEVICES_PER_CELL=1
LOUD_EVENT_DB=75
PUBLISH_INTERVAL_S=30
BACKGROUND_JOBS=1
RETENTION_DAYS=730
INACTIVE_DELETE_DAYS=60
CORS_ORIGIN=https://wenigerlaerm.ch,https://stadtlaerm.ch
REGISTRATIONS_PER_IP_PER_DAY=10
REQUESTS_PER_DEVICE_PER_HOUR=360
MAX_BODY_BYTES=2000000
MAX_RECORD_AGE_DAYS=7
CLOCK_SKEW_S=600

# Used only by scripts/backup.sh on the host
BACKUP_PASSPHRASE_FILE=/root/.stadtlaerm-backup-passphrase
BACKUP_DIR=/var/backups/stadtlaerm
BACKUP_REMOTE=
