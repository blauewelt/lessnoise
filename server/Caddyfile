# Caddy gets and renews a Let's Encrypt certificate for each host in API_HOSTS on its own
# (default in compose.yaml: api.lessnoise.ch and api.stadtlaerm.ch, both serve the same API).
# Ports 80 and 443 must reach this machine and each host's DNS record must point here; a host
# whose record does not exist yet gets no certificate (Caddy retries) and the others still work.
{$API_HOSTS} {
	encode gzip
	request_body {
		max_size 2MB
	}
	# No access log: the server keeps no per-request IP addresses on disk.
	reverse_proxy app:8000
}
