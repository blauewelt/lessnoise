<?xml version="1.0" encoding="utf-8"?>
<!-- PUBLIC edition («Online-Version», release asset lessnoise-karte.apk) only; NOT merged into
     the offline edition, which shares the Kotlin sources of src/public/ but not this manifest.
     Network access for two things (server/DESIGN.md §2, §4, §9; PRIVACY.md): (1) the opt-in upload
     «Messwerte teilen», by exactly one class, upload/UploadClient.kt, for exactly one host
     (BuildConfig.API_BASE, https://api.lessnoise.ch), and only after the person switched
     sharing on; (2) since 0.6.3 the tab «Karte», a WebView (src/karte/.../ui/MapScreen.kt) that
     shows https://wenigerlaerm.ch/karte.html only while the tab is open, like a browser: the page,
     swisstopo's map tiles and the published map files, no other host, no cookies, no location.
     The meta-data below keeps the WebView from sending usage metrics to Google.
     ACCESS_NETWORK_STATE: Android requires it for background jobs that wait for a
     network («nur über WLAN»); it shows whether a connection is up and metered, nothing else.
     Location (0.6.0): ACCESS_FINE_LOCATION + ACCESS_COARSE_LOCATION (Android 12+ needs both in
     one request so that the person can choose «Genau» or «Ungefähr»), used only while the app is
     open and only for (1) one fix right after «Starten» of a shared measurement, turned into a point that is
     moved at random by the location noise on the phone (only the shifted point is stored and sent,
     never the coordinates of the fix), and (2) one fix for «Laut! Melden»,
     whose exact coordinates are sent with that report and deleted from the phone once the server
     has it (location/LocationFetcher.kt, upload/Reports.kt). Never in the background:
     ACCESS_BACKGROUND_LOCATION is removed in src/main. The location
     hardware is optional (pasting coordinates works without it). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application>
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />
    </application>
</manifest>
