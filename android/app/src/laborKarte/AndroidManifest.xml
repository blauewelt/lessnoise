<?xml version="1.0" encoding="utf-8"?>
<!-- LABOR-KARTE edition only (flavour laborKarte, ch.stadtlaerm.labor, internal, never published):
     the Labor build plus the opt-in upload «Messwerte teilen». This variant compiles the Kotlin and
     resources of src/labor/ but NOT src/labor/AndroidManifest.xml (which removes these two
     permissions); the plain Labor build keeps no network access.
     Network access exactly as in the Karten-Version (src/public/AndroidManifest.xml): used by one
     class, upload/UploadClient.kt, for one host (BuildConfig.STADTLAERM_API,
     https://api.stadtlaerm.ch), only after the person switched sharing on. It sends the same
     measurement values as the Karten-Version, never audio: the upload code reads only the Room
     tables (UploadSourceIsolationTest). ACCESS_NETWORK_STATE: needed by Android for background jobs
     that wait for a network («nur über WLAN»). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
