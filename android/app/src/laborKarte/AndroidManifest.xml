<?xml version="1.0" encoding="utf-8"?>
<!-- LABOR-KARTE edition only (flavour laborKarte, ch.lessnoise.labor, internal, never published):
     the Labor build plus the opt-in upload «Messwerte teilen». This variant compiles the Kotlin and
     resources of src/labor/ but NOT src/labor/AndroidManifest.xml (which removes these two
     permissions); the plain Labor build keeps no network access.
     Network access exactly as in the «Online-Version» (src/public/AndroidManifest.xml): used by one
     class, upload/UploadClient.kt, for one host (BuildConfig.API_BASE,
     https://api.lessnoise.ch), only after the person switched sharing on. It sends the same
     measurement values and reports as the «Online-Version», never audio: the upload code reads only the Room
     tables (UploadSourceIsolationTest). Since 0.6.3 also the tab «Karte» (WebView with the website's
     map page while the tab is open; src/karte/.../ui/MapScreen.kt), as in the «Online-Version»,
     with WebView metrics switched off (meta-data below). ACCESS_NETWORK_STATE: needed by Android for
     background jobs that wait for a network («nur über WLAN»).
     Location (0.6.0) exactly as in the «Online-Version»: ACCESS_FINE_LOCATION +
     ACCESS_COARSE_LOCATION only for one fix right after «Starten» of a shared measurement (turned into a point
     moved at random on the phone; only that point is sent) and for «Laut! Melden» (exact place sent with the report, then deleted
     from the phone); only while the app is open, never in the
     background). The plain Labor build has neither (src/labor/AndroidManifest.xml).
     0.6.9 (Labor·Karte only, the owner's test phone): the position as a second «unterwegs» signal in a
     «Messen» run (src/laborKarte/kotlin/.../position/): about once a minute at low power (fused provider
     with balanced accuracy, or the network provider), only while the run goes, read by the measuring
     foreground service, which for that is started from the app's screen with the additional type
     «location» (FOREGROUND_SERVICE_LOCATION) — only if location is granted. Never ACCESS_BACKGROUND_LOCATION
     (src/main removes it). Only the run's first fix and the latest distance stay in memory; nothing is
     stored or sent. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application>
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />
        <!-- 0.8.4: «Laut! Melden» from the home screen (src/karte/…/report/): the static app shortcut
             (res/xml/shortcuts.xml of this flavour) and the widget (one button). Both only open the
             report dialog (action ch.lessnoise.app.action.REPORT_NOW); neither sends anything, reads
             anything or runs in the background. No new permission. -->
        <activity android:name=".ui.MainActivity">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <receiver
            android:name=".report.ReportWidget"
            android:exported="false"
            android:label="@string/report_now_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/report_widget_info" />
        </receiver>
        <service
            android:name=".service.MeasurementService"
            android:foregroundServiceType="microphone|shortService|location"
            tools:replace="android:foregroundServiceType" />
    </application>
</manifest>
